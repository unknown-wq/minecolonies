accessWidener	v2	official

# Port of src/main/resources/META-INF/accesstransformer.cfg to Fabric.
# Header namespace is "official" because 26.1+ ships unobfuscated with Mojang names, so member
# paths are written exactly as they appear in /opt/mc-src.

# --- keybinds -----------------------------------------------------------------------------------
# event/ClientEventSubscriber: replays a pick-block press.
accessible	field	net/minecraft/client/KeyMapping	clickCount	I
mutable	field	net/minecraft/client/KeyMapping	clickCount	I

# --- placeholder substitution -------------------------------------------------------------------
# util/BlockUtils: decides whether a block is a plausible "solid" replacement.
accessible	field	net/minecraft/world/level/block/state/BlockBehaviour	hasCollision	Z

# --- world gen settings -------------------------------------------------------------------------
# Dropped in 26.3-snapshot-10, which deleted SurfaceRules along with the NoiseChunk overload these six
# lines widened. util/BlockUtils now asks MaterialSystem#topMaterial, which is public, so nothing here
# has to be reopened. What blocks the inline is not the arguments -- DensityVolume is a public record
# with public constructors, and a DensitySamplerSet comes out of the public
# RandomState#samplersWithContext(SamplerContext), which BlockUtils itself calls. It is MaterialRuleContext:
# the class is public, but its constructor and its updateXZ/updateY are package-private, so one can be
# neither built nor stepped from outside net.minecraft.world.level.levelgen.material.

# --- dropped from the NeoForge access transformer -----------------------------------------------
# public-f net.minecraft.client.renderer.RenderStateShard setupState
#   -> RenderStateShard does not exist in 26.2 (render pipelines replaced it).
# public com.mojang.blaze3d.platform.GlStateManager BLEND / BlendState / BooleanState
#   -> GlStateManager does not exist in 26.2 (Blaze3D rewrite, Vulkan backend).
# public net.minecraft.world.entity.decoration.{ItemFrame,GlowItemFrame} getFrameItemStack
