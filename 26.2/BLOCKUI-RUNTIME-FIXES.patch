--- a/26.2/src/main/java/com/ldtteam/common/language/ClientLocale.java
+++ b/26.2/src/main/java/com/ldtteam/common/language/ClientLocale.java
@@ -7,6 +7,11 @@ public class ClientLocale
     public static String getLocale()
     {
         // Trust me, Minecraft.getInstance() can be null, when you run Data Generators!
-        return Minecraft.getInstance() == null ? null : Minecraft.getInstance().options.languageCode;
+        // 26.2: and it can also be non-null with options still unset -- mod entrypoints are invoked from
+        // inside Minecraft.<init>, before the options are loaded, so anything that reads the locale during
+        // mod init NPEs here. Returning null is safe: load() formats the path with it, finds nothing and
+        // falls back to the default locale.
+        final Minecraft mc = Minecraft.getInstance();
+        return mc == null || mc.options == null ? null : mc.options.languageCode;
     }
 }
