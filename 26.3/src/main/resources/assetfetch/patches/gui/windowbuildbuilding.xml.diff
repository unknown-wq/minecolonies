--- a/gui/windowbuildbuilding.xml
+++ b/gui/windowbuildbuilding.xml
@@ -36,0 +37,22 @@
+    <!-- Free mode only: the level to build to. WindowBuildBuilding hides this unless the colony has free mode on;
+         it is not hidden here, because a dropdown built from params with visible="false" hides its own button too. -->
+    <dropdown id="buildlevel"
+              size="43 17"
+              pos="356 0"
+              maxContentHeight="75"
+              dropDownSize="43 75"
+              source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png"
+              color="black">
+        <view size="100% 15">
+            <text id="id" size="100% 100%" label="" pos="0 0"/>
+            <button id="button" size="43 17" pos="0 0"
+                         source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png" color="black"/>
+        </view>
+    </dropdown>
+
+    <!-- Free mode only: take the building down and build it again from bare ground. Hidden here and shown by
+         WindowBuildBuilding, which also shrinks the resource list above it to make the row fit inside the window's
+         240 pixels. No label: the window writes one that names the level it would build. -->
+    <button id="rebuild" size="129 17" pos="145 200" visible="false"
+                 source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png" color="black"/>
