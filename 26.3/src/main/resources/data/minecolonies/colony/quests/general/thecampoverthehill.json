  "objectives": [
    {
      "type": "minecolonies:dialogue",
      "target": 0,
      "text": "I have had scouts out past the tree line for a week and they have found what I was afraid of: a barbarian camp, close enough that they can see our smoke. Camps like that do not sit still. Every night it stands is a night they spend counting our gates. I would rather we went to them.",
      "options": [
        {
          "answer": "Show me where it is.",
          "result": {
            "type": "minecolonies:dialogue",
            "text": "Take the road out and my scouts will point you the rest of the way. Kill the ones standing guard, then break every spawner in the camp - that is the part that matters. Leave one standing and it will all be back inside a week.",
            "options": [
              {
                "answer": "It will be cleared by morning.",
                "result": {
                  "type": "minecolonies:advanceobjective",
                  "go-to": 1
                }
              }
            ]
          }
        },
        {
          "answer": "We are not ready for that yet.",
          "result": {
            "type": "minecolonies:return"
          }
        }
      ]
    },
    {
      "type": "minecolonies:raidercamp",
      "details": {
        "target": 0,
        "entity-type": "minecolonies:campbarbarian",
        "qty": 8,
        "structure": "minecolonies:camps/small_barbarian_camp",
        "min-range": 120,
        "max-range": 220,
        "next-objective": 2
      }
    },
    {
      "type": "minecolonies:breakblock",
      "details": {
        "target": 0,
        "block": "minecraft:spawner",
        "qty": 5,
        "next-objective": 3
      }
    },
    {
      "unlocks-rewards": [0, 1, 2, 3, 4],
      "type": "minecolonies:dialogue",
      "target": 0,
      "text": "The scouts walked the ground this morning and there is nothing left standing. No spawners, no watch, no fires. That is the first quiet week this colony has had. Whatever was going to come out of that camp is not coming now - take this, and my thanks with it.",
      "options": [
        {
          "answer": "Sleep well, then.",
          "result": {
            "type": "minecolonies:advanceobjective",
            "go-to": 4
          }
        }
      ]
    }
  ],
