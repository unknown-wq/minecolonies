# build output
/build
/*/build
/.gradle
/*/.gradle
/out
/*/out
/classes

# The anchored rules above only reach one level deep, so a per-version module
# such as worldmap/26.3/ kept its build and run directories in the status
# listing -- classes, saved worlds and region files, hundreds of megabytes of
# them. These reach any depth.
**/build/
**/run/
**/.gradle/
**/.staged-libs/

# Fabric API jars the build downloads next to the checkout. Anchored to the
# root on purpose: the datagen caches under 26.x/src/main/generated/.cache/ are
# deliberately tracked and have to stay visible in status, or a re-stamp of the
# cache would go unnoticed.
/.cache/

# gradle/loom run dirs
/run
/*/run
/runs
/*/runs
/runClient
/runServer
/runData

# decompiled sources and scratch files produced during the port
/mc-src
/tmp
*.log
logs/
*.hprof

# IDE
/.idea
/*.iml
/.vscode
/.settings
/.classpath
/.project

# OS
**/.DS_Store
**/Thumbs.db

# Agent worktrees. The harness checks agent worktrees out inside the repo, so
# without this an in-flight agent's whole tree shows up as untracked files.

# Test harness leftovers. Server stands and background measurement loops drop
# their process ids next to wherever they were started from, which is sometimes
# a checkout rather than the stand's own directory.
*.pid
.cache/

# Python bytecode. tools/mc-colonydiff.py is run directly, but importing it or
# syntax-checking it with py_compile leaves a cache directory next to it.
__pycache__/
*.pyc
